#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd "$HOME/Projects/MeoArch_os workspace/build" && /usr/bin/ccmake -S"$HOME/Projects/MeoArch_os workspace/MeoArch-assets/MeoUI" -B"$HOME/Projects/MeoArch_os workspace/build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd "$HOME/Projects/MeoArch_os workspace/build" && /usr/bin/cmake --regenerate-during-build -S"$HOME/Projects/MeoArch_os workspace/MeoArch-assets/MeoUI" -B"$HOME/Projects/MeoArch_os workspace/build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


