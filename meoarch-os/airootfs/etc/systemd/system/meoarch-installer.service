[Unit]
Description=MeoArch graphical installer kiosk
# The kiosk must be available before network readiness and Pacman keyring
# preparation.  Networking is still requested in parallel for pages that need
# it, but it is not a prerequisite for showing the installer.
After=systemd-user-sessions.service systemd-logind.service
Wants=NetworkManager.service
Conflicts=getty@tty1.service systemd-networkd.service systemd-networkd.socket
OnFailure=meo-boot-status-failure@meoarch-installer.service

[Service]
Type=simple
User=root
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=QT_QPA_PLATFORM=wayland
Environment=MEO_UI_QML_IMPORT_PATH=/usr/lib/qt6/qml
Environment=QML2_IMPORT_PATH=/opt/meoarch-installer/qml:/usr/lib/qt6/qml
Environment=XKB_DEFAULT_LAYOUT=us
EnvironmentFile=-/etc/meoarch/account.env
ExecStartPre=/usr/lib/meoarch/meo-boot-status stage installer
ExecStart=/usr/local/bin/meoarch-installer-kiosk
ExecStartPost=/usr/lib/meoarch/meo-boot-status stage ready
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
