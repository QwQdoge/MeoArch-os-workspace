# MeoArch Plymouth boot splash
# Minimal black handoff surface: logo only during normal boot, with a soft
# fade near the graphical-session handoff. Error text remains available when
# boot status reports a failure.

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

logo_image = Image("logo.png");
logo_sprite = Sprite();
logo_glow_image = 0;
logo_glow_sprite = Sprite();
logo_opacity = 0.0;
boot_progress = 0.0;
is_error_state = 0;
frame_count = 0;

if (logo_image) {
    # Use a slightly enlarged copy of the logo as a low-opacity halo. This
    # stays intentionally subtle and avoids a separate animation asset.
    logo_glow_image = logo_image.Scale(
        logo_image.GetWidth() * 1.08,
        logo_image.GetHeight() * 1.08
    );
    if (logo_glow_image) {
        logo_glow_sprite.SetImage(logo_glow_image);
        logo_glow_sprite.SetX(screen_width / 2 - logo_glow_image.GetWidth() / 2);
        logo_glow_sprite.SetY(screen_height / 2 - logo_glow_image.GetHeight() / 2);
        logo_glow_sprite.SetZ(9);
        logo_glow_sprite.SetOpacity(0.0);
    }

    logo_sprite.SetImage(logo_image);
    logo_sprite.SetX(screen_width / 2 - logo_image.GetWidth() / 2);
    logo_sprite.SetY(screen_height / 2 - logo_image.GetHeight() / 2);
    logo_sprite.SetZ(10);
    logo_sprite.SetOpacity(0.0);
}

status_sprite = Sprite();
status_sprite.SetZ(30);
status_sprite.SetY(screen_height / 2 + 84);
status_sprite.SetOpacity(0.0);

fun set_error_text(text) {
    err_img = Image.Text(text, 1.0, 0.42, 0.42);
    if (err_img) {
        status_sprite.SetImage(err_img);
        status_sprite.SetX(screen_width / 2 - err_img.GetWidth() / 2);
        status_sprite.SetOpacity(1.0);
    }
}

fun refresh_callback() {
    frame_count = frame_count + 1;

    if (!is_error_state && logo_image) {
        # Fade in gently on first paint. Keep the boot screen deliberately
        # quiet: no spinner, status text, footer, or progress bar.
        if (frame_count < 24 && logo_opacity < 1.0) {
            logo_opacity = Math.Min(1.0, logo_opacity + 0.06);
        }

        # systemd boot progress approaches 1.0 shortly before the graphical
        # target. Fade the logo toward black so Cage inherits a dark frame
        # instead of a bright hard cut.
        if (boot_progress >= 0.90) {
            logo_opacity = Math.Max(0.0, logo_opacity - 0.045);
        }

        # A very slow, shallow breathing halo adds depth without creating a
        # spinner-like distraction. It fades with the main logo at handoff.
        if (logo_glow_sprite) {
            glow_opacity = logo_opacity * (
                0.08 + (Math.Cos(frame_count * 0.08) + 1.0) * 0.02
            );
            logo_glow_sprite.SetOpacity(glow_opacity);
        }
        logo_sprite.SetOpacity(logo_opacity);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
    if (progress >= 0.0 && progress <= 1.0)
        boot_progress = progress;
}

Plymouth.SetBootProgressFunction(progress_callback);

fun message_callback(text) {
    if (text == "")
        return;

    if (String(text).SubString(0, 6) == "ERROR:") {
        is_error_state = 1;
        if (logo_glow_sprite)
            logo_glow_sprite.SetOpacity(0.0);
        if (logo_sprite)
            logo_sprite.SetOpacity(0.28);
        set_error_text(text);
    }
}

Plymouth.SetUpdateStatusFunction(message_callback);
Plymouth.SetDisplayMessageFunction(message_callback);

fun mode_callback(mode) {
    # Keep shutdown/reboot minimal too. The normal boot handoff is the main
    # concern here; no extra text is painted unless an error is reported.
    if (mode == "boot") {
        is_error_state = 0;
        status_sprite.SetOpacity(0.0);
    }
}

Plymouth.SetModeFunction(mode_callback);

fun quit_callback() {
    # Plymouth cannot guarantee a multi-frame animation after quit is requested,
    # so the regular refresh loop performs the visible fade before graphical
    # target. Finish on black if quit arrives first.
    if (logo_glow_sprite)
        logo_glow_sprite.SetOpacity(0.0);
    if (logo_sprite)
        logo_sprite.SetOpacity(0.0);
    status_sprite.SetOpacity(0.0);
}

Plymouth.SetQuitFunction(quit_callback);
