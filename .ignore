# Ignore patterns for MeoArch_os project
# Build directories
build/
# Qt QML compiled files
*.qmlc
# Qt generated moc files
*.moc
# Object files and binaries
*.o
*.obj
*.so
*.dll
*.exe
# Python cache
__pycache__/
*.pyc
# IDE settings
.vscode/
# Temporary files
*.tmp
# Log files
*.log
# Generated documentation
*.html
# Other generated assets
*.qmljs
# End of ignore patterns
/build
./vscode
