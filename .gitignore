# ==========================================
# MeoArch OS Workspace Git Ignore Patterns
# ==========================================

# --- C++ & CMake Build Outputs ---
build/
out/
bin/
!installer/bin/
!installer/bin/meoarch-installer
!installer/bin/meoarch-installer-kiosk
lib/
CMakeCache.txt
CMakeFiles/
CMakeSettings.json
cmake_install.cmake
Makefile
*.ninja
.ninja_*
compile_commands.json

# --- Compiled Object Files & Libraries ---
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.la
*.lai
*.lo

# --- Qt & QML Generated Files ---
*.qmlc
*.jsc
*.moc
moc_*.cpp
qrc_*.cpp
*.qrc.depends
ui_*.h
*.qmltypes
*.qmljs
.qt/

# --- Archiso / OS Build Outputs ---
*.iso
*.img
work/
artifacts/
MeoArch_os*.iso
MeoArch-os*.iso
# Generated installer payload synced into the archiso tree
MeoArch\ os/airootfs/opt/meoarch-installer/
meoarch-os/airootfs/opt/meoarch-installer/
meoarch-os/airootfs/opt/meo-desktop/
meoarch-os/airootfs/usr/lib/qt6/qml/MeoUI/
meoarch-os/airootfs/usr/lib/qt6/qml/MeoKDE/
meoarch-os/airootfs/usr/share/fonts/meo/

# --- Python Cache & Virtual Environments ---
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/

# --- IDEs and Editors ---
.vscode/
.idea/
*.suo
*.user
*.workspace
*.sublime-project
*.sublime-workspace

# --- Secrets, credentials & machine-local config ---
.env
.env.*
*.env
!*.env.example
!*.env.sample
# This tracked file intentionally contains public/empty connection metadata only.
!meoarch-os/airootfs/etc/meoarch/account.env
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.mobileprovision
credentials*.json
secrets*.json
*.secrets.*
.npmrc
.pypirc
.netrc
auth.json
private-keys-v1.d/

# --- Logs, Temps & Dumps ---
*.log
*.tmp
*.temp
*.swp
*.swo
*~
.directory
.DS_Store
Thumbs.db
node_modules/
