[Unit]
Description=MeoArch Boot Storage Stage Milestone
After=local-fs.target

[Service]
Type=oneshot
# Boot-status is cosmetic.  Keep an independent circuit breaker even if its
# helper regresses, so it cannot delay the Live installer.
TimeoutStartSec=5s
ExecStart=/usr/lib/meoarch/meo-boot-status stage storage

[Install]
WantedBy=local-fs.target
