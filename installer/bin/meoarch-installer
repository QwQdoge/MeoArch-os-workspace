#!/usr/bin/env bash
set -euo pipefail

app_dir="${MEOARCH_INSTALLER_DIR:-/opt/meoarch-installer}"
state_dir="${MEOARCH_INSTALLER_STATE_DIR:-/tmp/meoarch-installer}"
meoui_import_path="${MEO_UI_QML_IMPORT_PATH:-/usr/lib/qt6/qml}"
qml_args=()
repair_mode=false

usage() {
  cat <<'EOF'
Usage: meoarch-installer [options] [-- QML_ARGS...]

Options:
  --production                    Mark an ISO-controlled production launch.
  --repair                        Open the shared Quick Repair app (AI is optional).
  --enable-system-actions         Enable power actions only together with --production.
  --enable-real-install           Allow the guarded Archinstall adapter only together with --production.
  -h, --help                      Show this help.

Defaults are non-destructive. The kiosk launcher is the only ISO entrypoint that supplies production capabilities.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --production)
      qml_args+=("--production")
      shift
      ;;
    --repair)
      repair_mode=true
      shift
      ;;
    --enable-system-actions)
      qml_args+=("--enable-system-actions")
      shift
      ;;
    --enable-real-install)
      qml_args+=("--enable-real-install")
      shift
      ;;
    --)
      shift
      qml_args+=("$@")
      break
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      qml_args+=("$1")
      shift
      ;;
  esac
done

mkdir -p "${state_dir}"

if [ "${repair_mode}" = true ]; then
  repair_app="${MEOARCH_REPAIR_APP:-/usr/bin/meoarch-repair}"
  if [ -x "${repair_app}" ]; then
    exec "${repair_app}" --live
  fi
  echo "MeoArch Quick Repair is not installed at ${repair_app}." >&2
  exit 127
fi

native_app="${app_dir}/bin/meoarch-installer-app"
if [ -x "${native_app}" ]; then
  missing_libraries="$(ldd "${native_app}" 2>/dev/null | awk '/not found/ { print $1 }' | paste -sd, -)"
  if [ -z "${missing_libraries}" ]; then
    export MEOARCH_INSTALLER_ROOT="${app_dir}"
    export MEOARCH_INSTALLER_QML_ROOT="${app_dir}/qml"
    export MEO_UI_QML_IMPORT_PATH="${meoui_import_path}"
    exec "${native_app}" "${qml_args[@]}"
  fi
  echo "Native installer host is missing libraries (${missing_libraries}); using the QML runtime." >&2
fi

main_qml="${app_dir}/qml/Main.qml"

export QML2_IMPORT_PATH="${app_dir}/qml:${meoui_import_path}:/usr/lib/qt6/qml${QML2_IMPORT_PATH:+:${QML2_IMPORT_PATH}}"
if command -v qml6 >/dev/null 2>&1; then
  exec qml6 -I "$meoui_import_path" "$main_qml" "${qml_args[@]}"
elif command -v qml >/dev/null 2>&1; then
  exec qml -I "$meoui_import_path" "$main_qml" "${qml_args[@]}"
elif command -v qmlscene6 >/dev/null 2>&1; then
  exec qmlscene6 -I "$meoui_import_path" "$main_qml" "${qml_args[@]}"
elif command -v qmlscene >/dev/null 2>&1; then
  exec qmlscene -I "$meoui_import_path" "$main_qml" "${qml_args[@]}"
fi

echo "No Qt QML runtime found. Install qt6-declarative." >&2
exit 127
