#!/usr/bin/env bash
set -euo pipefail

app_dir="${MEOARCH_INSTALLER_DIR:-/opt/meoarch-installer}"
main_qml="${app_dir}/qml/Main.qml"
state_dir="${MEOARCH_INSTALLER_STATE_DIR:-/tmp/meoarch-installer}"
meoui_import_path="${MEO_UI_QML_IMPORT_PATH:-/opt/meo-ui/qml}"
enable_archinstall_preflight=0
qml_args=()

usage() {
  cat <<'EOF'
Usage: meoarch-installer [options] [-- QML_ARGS...]

Options:
  --enable-archinstall-preflight  Run archinstall --dry-run preflight in the background.
  --enable-system-actions         Enable QML system-action requests for future native bridge testing.
  -h, --help                      Show this help.

Defaults are non-destructive: no archinstall preflight and no enabled system actions.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --enable-archinstall-preflight)
      enable_archinstall_preflight=1
      shift
      ;;
    --enable-system-actions)
      qml_args+=("--enable-system-actions")
      shift
      ;;
    --)
      shift
      qml_args+=("$@")
      break
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      qml_args+=("$1")
      shift
      ;;
  esac
done

mkdir -p "${state_dir}"

if [ "${enable_archinstall_preflight}" -eq 1 ] && [ -x "${app_dir}/backend/archinstall-preflight.sh" ]; then
  MEOARCH_INSTALLER_STATE_DIR="${state_dir}" \
    "${app_dir}/backend/archinstall-preflight.sh" >/dev/null 2>&1 &
fi

if command -v qml6 >/dev/null 2>&1; then
  exec qml6 -I "$meoui_import_path" "$main_qml" "${qml_args[@]}"
elif command -v qml >/dev/null 2>&1; then
  exec qml -I "$meoui_import_path" "$main_qml" "${qml_args[@]}"
elif command -v qmlscene6 >/dev/null 2>&1; then
  exec qmlscene6 -I "$meoui_import_path" "$main_qml" "${qml_args[@]}"
elif command -v qmlscene >/dev/null 2>&1; then
  exec qmlscene -I "$meoui_import_path" "$main_qml" "${qml_args[@]}"
fi

echo "No Qt QML runtime found. Install qt6-declarative." >&2
exit 127
